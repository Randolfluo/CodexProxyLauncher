<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexProxyLauncher</AssemblyName>
    <RootNamespace>CodexProxyLauncher</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Community proxy launcher for Codex Desktop</Description>
    <Authors>Randolfluo</Authors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>App.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <LangVersion>12.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>App.NETFramework.manifest</ApplicationManifest>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <EmbeddedResource Include="App.NETFramework.config" LogicalName="CodexProxyLauncher.WinForms.config" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="CodexProxyLauncher.App.ico" />
    <EmbeddedResource Include="Launcher.ps1" LogicalName="Launcher.ps1" />
    <InternalsVisibleTo Include="CodexProxyLauncher.StartupTests" />
  </ItemGroup>
</Project>
